# Inject these variables into the server environment; .env is not loaded automatically.
# Required for persistent cart plans and writes; public catalog reads need no database.
DATABASE_URL=postgresql+psycopg://USER:PASSWORD@localhost:5432/digikala_mcp
# Set both limits before increasing or replacing cart contents. Amounts are integer rials.
INCART_CART_MAX_TOTAL_RIAL=50000000
INCART_CART_MAX_ITEMS=3
